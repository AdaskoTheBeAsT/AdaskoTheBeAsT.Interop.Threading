<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0;net481;net48;net472</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AdaskoTheBeAsT.Interop.Threading\AdaskoTheBeAsT.Interop.Threading.csproj" />
  </ItemGroup>

  <!-- Native tests are a separate host-selected suite, not failed "skip" helpers.
       Linux runs only portable timeout contracts, without touching Win32. -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Compile Remove="**/*.cs" />
    <Compile Include="TaskExtension*.cs" />
  </ItemGroup>

</Project>
